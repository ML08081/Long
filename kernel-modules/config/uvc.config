# =============================================================================
#  uvc.config -- 启用 USB 摄像头(UVC) + V4L2 核心的内核配置片段
#  合并方式(见 02_build_modules.sh):
#     scripts/kconfig/merge_config.sh -m .config uvc.config && make olddefconfig
#  目标: 让 videodev / videobuf2-* / uvcvideo 以【模块 =m】方式编出
#  适配: Linux 4.19.x
# =============================================================================
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y

# V4L2 核心 (videodev.ko)
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_V4L2=m
CONFIG_V4L2_FWNODE=m

# videobuf2 (uvcvideo 依赖)
CONFIG_VIDEOBUF2_CORE=m
CONFIG_VIDEOBUF2_V4L2=m
CONFIG_VIDEOBUF2_MEMOPS=m
CONFIG_VIDEOBUF2_VMALLOC=m

# UVC 本体
CONFIG_USB_VIDEO_CLASS=m
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y
