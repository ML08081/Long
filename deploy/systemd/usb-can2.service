[Unit]
Description=Verify and bring up PCAN USB interface can2 at 500 kbit/s
After=systemd-modules-load.service
Before=usb-can2-recover.service usb-can2-recover.timer

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/loong-usb-can-up can2 500000
ExecStop=/usr/local/sbin/loong-usb-can-down can2
RemainAfterExit=yes
TimeoutStopSec=10
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
