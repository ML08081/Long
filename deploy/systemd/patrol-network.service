[Unit]
Description=PatrolSystem Wi-Fi station connection (MLML, DHCP)
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/patrol_setup_network /etc/patrol/network.conf
TimeoutStartSec=180
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
